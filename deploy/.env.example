# Non-secret Compose / deploy vars (safe for `$`-free interpolation).
# Quote values that contain spaces — Compose accepts quotes; `source` would not.
ARTALK_IMAGE_TAG=instance-latest
ARTALK_SITE_NAME="All-in-One Person"
ARTALK_SITE_URL=https://blog.themarfa.name
ARTALK_DOMAIN=comments.themarfa.name
ATK_TRUSTED_DOMAINS="https://blog.themarfa.name https://comments.themarfa.name"
ARTALK_ADMIN_NAME=admin
ARTALK_ADMIN_EMAIL=

# Optional local tooling
VPS_HOST=
VPS_USER=
VPS_SSH_KEY=~/.ssh/artalk_vps
