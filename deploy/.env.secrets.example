# Runtime secrets for the container (env_file only — may contain bcrypt `$`).
# Copy to /opt/artalk/.env.secrets (chmod 600). Never commit.
# In Compose env_file, write each bcrypt `$` as `$$` so the hash is not eaten.

ATK_APP_KEY=
ATK_ADMIN_USERS_0_PASSWORD=

# Marfabot (plaintext admin password optional if ATK_APP_KEY is set)
TELEGRAM_BOT_TOKEN=
MARFABOT_HOOK_SECRET=
ARTALK_ADMIN_PASSWORD=

# Optional private GHCR pull
# GHCR_USER=Marfa
# GHCR_TOKEN=
