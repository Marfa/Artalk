# Copy to /opt/artalk/.env on the VPS (never commit real values).

ARTALK_IMAGE_TAG=instance-latest
ARTALK_SITE_NAME=All-in-One Person
ARTALK_SITE_URL=https://blog.themarfa.name
ARTALK_DOMAIN=comments.themarfa.name
ATK_TRUSTED_DOMAINS=https://blog.themarfa.name https://comments.themarfa.name

# Passed into the container as-is via env_file (required).
ATK_APP_KEY=

# Admin bootstrap — use a bcrypt hash. Keep single `$` here (env_file, not Compose ${}).
# Example form: (bcrypt)$2b$10$xxxxxxxx
ATK_ADMIN_USERS_0_PASSWORD=
ARTALK_ADMIN_NAME=admin
ARTALK_ADMIN_EMAIL=

# Optional: private GHCR pull (public package needs none)
# GHCR_USER=Marfa
# GHCR_TOKEN=

# Optional local tooling
VPS_HOST=
VPS_USER=
VPS_SSH_KEY=~/.ssh/artalk_vps
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
